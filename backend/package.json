{
  "name": "chameleon-backend",
  "version": "1.0.0",
  "description": "Chameleon file conversion API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
