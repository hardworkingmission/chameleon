# Copy to /home/admin/chameleon/backend/.env ON EC2. Never commit the populated file.
# RDS must be MySQL (the Prisma schema uses provider = "mysql").
# Percent-encode special characters in username/password. Keep the URL quoted.
DATABASE_URL='mysql://chameleon:ENCODED_PASSWORD@YOUR_RDS_ENDPOINT:3306/chameleon?sslcert=/app/certs/global-bundle.pem&sslaccept=strict'
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://www.example.com

# Built-in Caddy HTTPS. Point this domain to the EC2 Elastic IP first.
APP_DOMAIN=api.example.com
COMPOSE_PROFILES=https
BACKEND_BIND_ADDRESS=127.0.0.1
TRUST_PROXY_HOPS=1

# Existing host proxy: COMPOSE_PROFILES= (empty), keep loopback binding.
# Existing ALB: COMPOSE_PROFILES= (empty), BACKEND_BIND_ADDRESS=0.0.0.0;
# allow EC2 port 4000 ONLY from the ALB security group. One proxy hop.

MAX_FILE_SIZE_MB=25
MAX_BATCH_FILES=20
RETENTION_MINUTES=60
CLEANUP_INTERVAL_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPUS=2
ENABLE_GOOGLE_OAUTH=false
ENABLE_GITHUB_OAUTH=false
